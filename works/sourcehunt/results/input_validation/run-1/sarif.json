          "ruleId": "out_of_bounds_write",
          "level": "warning",
          "message": {
            "text": "The loop bound `s->sh.nb_refs[L0]` is derived directly from the bitstream without validation against the maximum allowed number of references (16). It is used to index into fixed-size arrays `luma_weight_l0_flag`, `s->sh.luma_weight_l0`, and `s->sh.luma_offset_l0`, which have a capacity of 16 elements. If `nb_refs[L0]` exceeds 15, this results in a stack-based buffer overflow."
          },
          "locations": [
            {
              "physicalLocation": {
