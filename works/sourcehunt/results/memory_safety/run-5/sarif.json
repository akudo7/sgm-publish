          "ruleId": "Integer Overflow",
          "level": "warning",
          "message": {
            "text": "The multiplication `sps->min_pu_width * sps->min_pu_height` on line 61 can overflow a 32-bit signed integer if the SPS contains maliciously large dimensions. The truncated result is passed to `av_mallocz` on line 77, which lacks overflow protection. This results in an undersized heap allocation, leading to a heap buffer overflow when `s->tab_ipm` is subsequently accessed during decoding."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "libavcodec/hevcdec.c"
                },
                "region": {
                  "startLine": 61
                }
              }
            }
          ]
        },
