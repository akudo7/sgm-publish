      "type": "function",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof FullHarnessState.State"
          }
        ],
        "output": {},
        "functionFile": "json/functions/bootstrap_generator_node_2.js"
      }
    },
    {
      "id": "negotiate_node",
      "type": "function",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof FullHarnessState.State"
          },
          {
            "name": "model",
