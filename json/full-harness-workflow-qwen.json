            "stateType": "typeof FullHarnessState.State"
          }
        ],
        "output": {},
        "functionFile": "json/functions/context_reset_eval_node.js"
      }
    }
  ],
  "edges": [
    {
      "from": "__start__",
      "to": "bootstrap_planner_node"
    },
    {
      "from": "bootstrap_planner_node",
      "to": "planner_node"
    },
    {
      "from": "planner_node",
      "to": "bootstrap_generator_node"
    },
    {
      "from": "bootstrap_generator_node",
      "to": "negotiate_node"
    },
    {
      "from": "negotiate_node",
      "to": "generator_node"
    },
    {
      "from": "generator_node",
      "to": "bootstrap_evaluator_node"
    },
    {
      "from": "bootstrap_evaluator_node",
      "to": "context_reset_eval_node"
    },
    {
      "from": "evaluator_node",
      "to": "router_node"
    },
    {
      "from": "router_node",
      "type": "conditional",
      "condition": {
        "name": "routeSprint",
        "handler": {
          "parameters": [
            {
              "name": "state",
              "parameterType": "state",
              "stateType": "typeof FullHarnessState.State"
            }
          ],
          "output": "",
          "functionFile": "json/functions/node_28.js"
        },
        "possibleTargets": [
          "generator_node",
          "bootstrap_feedback_node",
          "__end__"
        ]
      }
    },
    {
      "from": "bootstrap_feedback_node",
      "to": "context_guard_node"
    },
    {
      "from": "context_guard_node",
      "to": "negotiate_node"
    },
    {
      "from": "context_reset_eval_node",
      "to": "evaluator_node"
    }
  ],
  "stateGraph": {
    "annotationRef": "FullHarnessState"
  }
}
