{
  "config": {
    "info": {
      "version": "1.0.0",
      "description": "Hooks workflow: sessionStart / userPromptSubmit / preToolUse / postToolUse の検証用",
      "copyright": "Copyright 2026",
      "author": "Akira Kudo"
    },
    "recursionLimit": 25,
    "eventEmitter": {
      "defaultMaxListeners": 10
    },
    "store": {
      "type": "InMemoryStore"
    },
    "bashCommandAllowedCommands": [
      "git",
      "yarn",
      "npm",
      "npx",
      "node",
      "tsx",
      "docker",
      "ls",
      "cat",
      "echo",
      "pwd",
      "mkdir",
      "rm",
      "mv",
      "cp",
      "chmod",
      "find",
      "head",
      "tail",
      "wc",
      "grep",
      "sed",
      "awk",
      "sort",
      "uniq",
      "tee"
    ]
  },
  "models": [
    {
      "id": "agent",
      "type": "LlamaCpp",
      "config": {
        "model": "unsloth/Qwen3.6-35B-A3B",
        "temperature": 0.7,
        "serverUrl": "http://localhost:8001"
      },
      "bindSystemSkills": true,
      "systemPrompt": "あなたはTODO管理を支援するAIアシスタントです。ユーザーのタスク管理をサポートします。\n\nTODO管理のルール:\n1. タスクを追加・更新する際は write_todos ツールを使用してください\n2. 現在のタスク一覧を確認する際は read_todos ツールを使用してください\n3. タスクのステータス変更は、read_todos で全件取得 → 編集 → write_todos で保存するパターンで行ってください\n4. 優先度はユーザーの指示がなければ medium を使用してください",
      "skills": {
        "enabled": true,
        "skillsPath": "skills",
        "backend": {
          "rootDir": "."
        }
      }
    }
  ],
  "nodes": [
    {
      "id": "agent",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof HooksJsonState.State"
          }
        ],
        "function": "return { messages: [new AIMessage({ content: '', tool_calls: [{ id: 'call_hooks', name: 'bash_command', args: { command: 'echo hooks-json-ok' } }] })] };"
      }
    },
    {
      "id": "tools",
      "type": "ToolNode",
      "useSystemSkills": true
    }
  ],
  "edges": [
    {
      "from": "__start__",
      "to": "agent"
    },
    {
      "from": "agent",
      "to": "tools"
    },
    {
      "from": "tools",
      "to": "__end__"
    }
  ],
  "stateGraph": {
    "annotationRef": "HooksJsonState"
  },
  "stateAnnotation": {
    "name": "HooksJsonState",
    "type": "Annotation.Root"
  },
  "annotation": {
    "messages": {
      "type": "BaseMessage[]",
      "reducer": "(x, y) => x.concat(y)",
      "default": []
    },
    "result": {
      "type": "string",
      "reducer": "(x, y) => y || x",
      "default": ""
    }
  }
}
