{
  "config": {
    "info": {
      "version": "1.0.0",
      "description": "Bootstrap flow — planner → generator → evaluator with feedback loop",
      "copyright": "Copyright 2026",
      "author": "Akira Kudo"
    },
    "recursionLimit": 30,
    "eventEmitter": {
      "defaultMaxListeners": 10
    }
  },
  "stateAnnotation": {
    "name": "BootstrapQwenState",
    "type": "Annotation.Root"
  },
  "annotation": {
    "messages": {
      "type": "BaseMessage[]",
      "reducer": "(x, y) => x.concat(y)",
      "default": "[]"
    },
    "taskSpec": {
      "type": "string",
      "reducer": "(x, y) => y",
      "default": "\"\""
    },
    "sprintContract": {
      "type": "{ goals: string[]; successCriteria: string[]; sprintNumber: number } | null",
      "reducer": "(x, y) => y",
      "default": "null"
    },
    "sprintResult": {
      "type": "{ passed: boolean; feedback: string; score: number } | null",
      "reducer": "(x, y) => y",
      "default": "null"
    },
    "retryCount": {
      "type": "number",
      "reducer": "(x, y) => x + y",
      "default": "0"
    },
    "activeMessages": {
      "type": "BaseMessage[]",
      "reducer": "(x, y) => { const isBootstrap = y.length === 1 && typeof y[0].content === 'string' && (/^=== (Generator Bootstrap|Evaluator Bootstrap|Feedback Bootstrap)/).test(y[0].content); return isBootstrap ? y : x.concat(y); }",
      "default": "[]"
    }
  },
  "models": [
    {
      "id": "negotiator_model",
      "type": "LlamaCpp",
      "config": {
        "model": "unsloth/Qwen3.8-27B",
        "temperature": 0.3,
        "serverUrl": "http://localhost:8001"
      },
      "systemPrompt": "You are a sprint negotiator. Define goals and success criteria for the given task. Respond with ONLY valid JSON, no other text: {\"goals\":[\"...\"],\"successCriteria\":[\"...\"]}"
    },
    {
      "id": "evaluator_model",
      "type": "LlamaCpp",
      "config": {
        "model": "unsloth/Qwen3.8-27B",
        "temperature": 0.3,
        "serverUrl": "http://localhost:8001"
      },
      "systemPrompt": "You are a sprint evaluator. If goals and successCriteria are clearly defined, set passed=true and score>=80. Respond with ONLY valid JSON, no other text: {\"passed\":true,\"feedback\":\"...\",\"score\":85}"
    }
  ],
  "nodes": [
    {
      "id": "bootstrap_planner_node",
      "type": "function",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof BootstrapQwenState.State"
          }
        ],
        "output": {},
        "functionFile": "json/functions/bootstrap_planner_node.js"
      }
    },
    {
      "id": "planner_node",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof BootstrapQwenState.State"
          }
        ],
        "output": {},
        "functionFile": "json/functions/planner_node.js"
      }
    },
    {
      "id": "bootstrap_generator_node",
      "type": "function",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof BootstrapQwenState.State"
          }
        ],
        "output": {},
        "functionFile": "json/functions/bootstrap_generator_node.js"
      }
    },
    {
      "id": "negotiate_node",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof BootstrapQwenState.State"
          },
          {
            "name": "model",
            "parameterType": "model",
            "modelRef": "negotiator_model"
          }
        ],
        "output": {},
        "functionFile": "json/functions/negotiate_node.js"
      }
    },
    {
      "id": "generator_node",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof BootstrapQwenState.State"
          }
        ],
        "output": {},
        "functionFile": "json/functions/generator_node.js"
      }
    },
    {
      "id": "bootstrap_evaluator_node",
      "type": "function",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof BootstrapQwenState.State"
          }
        ],
        "output": {},
        "functionFile": "json/functions/bootstrap_evaluator_node.js"
      }
    },
    {
      "id": "evaluator_node",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof BootstrapQwenState.State"
          },
          {
            "name": "model",
            "parameterType": "model",
            "modelRef": "evaluator_model"
          }
        ],
        "output": {},
        "functionFile": "json/functions/evaluator_node.js"
      }
    },
    {
      "id": "router_node",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof BootstrapQwenState.State"
          }
        ],
        "output": {},
        "functionFile": "json/functions/router_node.js"
      }
    },
    {
      "id": "bootstrap_feedback_node",
      "type": "function",
      "handler": {
        "parameters": [
          {
            "name": "state",
            "parameterType": "state",
            "stateType": "typeof BootstrapQwenState.State"
          }
        ],
        "output": {},
        "functionFile": "json/functions/bootstrap_feedback_node.js"
      }
    }
  ],
  "edges": [
    {
      "from": "__start__",
      "to": "bootstrap_planner_node"
    },
    {
      "from": "bootstrap_planner_node",
      "to": "planner_node"
    },
    {
      "from": "planner_node",
      "to": "bootstrap_generator_node"
    },
    {
      "from": "bootstrap_generator_node",
      "to": "negotiate_node"
    },
    {
      "from": "negotiate_node",
      "to": "generator_node"
    },
    {
      "from": "generator_node",
      "to": "bootstrap_evaluator_node"
    },
    {
      "from": "bootstrap_evaluator_node",
      "to": "evaluator_node"
    },
    {
      "from": "evaluator_node",
      "to": "router_node"
    },
    {
      "from": "bootstrap_feedback_node",
      "to": "bootstrap_generator_node"
    },
    {
      "from": "router_node",
      "type": "conditional",
      "condition": {
        "name": "routeSprint",
        "handler": {
          "parameters": [
            {
              "name": "state",
              "parameterType": "state",
              "stateType": "typeof BootstrapQwenState.State"
            }
          ],
          "output": "",
          "functionFile": "json/functions/node_14.js"
        },
        "possibleTargets": [
          "generator_node",
          "bootstrap_feedback_node",
          "__end__"
        ]
      }
    }
  ],
  "stateGraph": {
    "annotationRef": "BootstrapQwenState"
  }
}
